{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "宁宁静听",
  "version": "0.14.0",
  "identifier": "com.ttplayer.player",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "宁宁静听",
        "width": 390,
        "height": 160,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
